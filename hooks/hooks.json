{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*blockrun_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/spend-gate.js\"",
            "statusMessage": "Checking BlockRun spend"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*blockrun_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/spend-tally.js\""
          }
        ]
      }
    ]
  }
}
